# Server-only webhook for POST /api/refresh. Placeholders only. Do not put a real key here.
# The browser never receives REFRESH_WEBHOOK_KEY.
REFRESH_WEBHOOK_URL=https://example.com/hooks/cjmk-refresh
REFRESH_WEBHOOK_KEY=replace-with-webhook-key
# Optional. Defaults to Authorization, sent as "Bearer <key>".
# Any other header name sends the raw key as the value.
REFRESH_WEBHOOK_KEY_HEADER=
